// background.js — سرویس worker LingoVault 1.2.2
// اینجا همه الگوریتم Leitner، آمار، streak و آپدیت هفتگی اجرا می‌شه

chrome.runtime.onInstalled.addListener(() => {
  console.log("LingoVault 1.2.2 installed successfully");
});

chrome.alarms.onAlarm.addListener(async (alarm) => {
  if (alarm.name === "dailyGrowthCheck") {
    try {
      const dailyGoal = await chrome.storage.local.get("dailyGoalDone");
      if (dailyGoal.dailyGoalDone) {
        chrome.notifications.create("weeklyGrowth", {
          type: "basic",
          iconUrl: chrome.runtime.getURL("assets/icons/icon128.png"),
          title: "🌱 چالنج رشد هفتگی",
          message: "امروز فقط ۵ دقیقه وقت گذاشتید. چالنج رشد هفته رو ببینید!",
          buttons: [{ title: "بزن بریم" }]
        });
      }
    } catch (e) {}
  }
});

// باز کردن side panel از آیکون
chrome.action.onClicked.addListener(() => {
  chrome.sidePanel.open({ windowId: chrome.windows.WINDOW_ID_CURRENT });
});

// راه‌اندازی آلارم روزانه
chrome.alarms.create("dailyGrowthCheck", {
  periodInMinutes: 60 * 24, // هر ۲۴ ساعت
  when: Date.now() + 1000 * 60 * 5
});
